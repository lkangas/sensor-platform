#!/bin/sh
# Refresh the dy.fi hostname binding. dy.fi points the name at the source IP
# of this request, and expires names not refreshed within 7 days — so this must
# run FROM the VPS itself, on a timer (see dyfi-update.timer, every 5 days).
#
# Credentials live in /etc/dyfi.netrc (root:600, NOT in git):
#   machine www.dy.fi login <email> password <password>
#
# Install: copy to /usr/local/sbin/dyfi-update (mode 755) + the .service/.timer
# units to /etc/systemd/system/, then: systemctl enable --now dyfi-update.timer
set -eu
HOSTNAME_DYFI="petzval.dy.fi"
RESP=$(curl -fsS --netrc-file /etc/dyfi.netrc \
  -A "dyfi-update-script/1.0 ($HOSTNAME_DYFI)" \
  "https://www.dy.fi/nic/update?hostname=$HOSTNAME_DYFI")
logger -t dyfi-update "$HOSTNAME_DYFI: $RESP"
echo "$RESP"
