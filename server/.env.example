# Copy to .env on the VPS and fill with strong random values (e.g. `openssl rand -base64 24`).
# .env is git-ignored — NEVER commit the real one.

# TimescaleDB superuser (postgres)
POSTGRES_PASSWORD=

# Dedicated DB role for Telegraf (INSERT into sensor_readings)
TELEGRAF_DB_PASS=

# Read-only DB role for Grafana dashboards
GRAFANA_DB_PASS=

# Grafana admin login (user: admin)
GF_SECURITY_ADMIN_PASSWORD=

# --- Public hostnames (kept out of the committed configs; set the real values here) ---

# The VPS's public FQDN. Caddy obtains the TLS cert for it and mosquitto reuses that
# cert on 8883 — so edge nodes verify their MQTTS connection against this name. Must be
# a real, resolvable hostname (not an IP).
PUBLIC_FQDN=vps.example.com

# Grafana's public URL. Simplest: https://<PUBLIC_FQDN> (Caddy fronts it). If you later
# move Grafana behind a tunnel, point this at that app hostname instead.
GRAFANA_ROOT_URL=https://vps.example.com

# Let's Encrypt / ACME account contact email.
ACME_EMAIL=you@example.com
