    {
      "id": 10,
      "type": "table",
      "title": "Latest reading per sensor",
      "description": "Most recent row regardless of the dashboard time range \u2014 a stale 'age' means the sensor (or its site's publisher) is offline.",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 900
                    },
                    {
                      "color": "red",
                      "value": 3600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "humidity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "humidity"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pressure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "pressurehpa"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "battery"
            },
            "properties": [
              {
                "id": "unit",
                "value": "mvolt"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2300
                    },
                    {
                      "color": "text",
                      "value": 2600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "sensor"
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (sensor_id)\n  COALESCE(sensor_name, sensor_id) AS \"sensor\",\n  extract(epoch FROM now() - time) AS \"age\",\n  temperature AS \"temperature\",\n  humidity AS \"humidity\",\n  round(pressure::numeric, 1) AS \"pressure\",\n  battery_mv AS \"battery\",\n  rssi AS \"rssi\"\nFROM sensor_readings\nWHERE site IN (${site:sqlstring}) AND sensor_id IN (${sensor:sqlstring})\nORDER BY sensor_id, time DESC"
        }
      ]
    },
