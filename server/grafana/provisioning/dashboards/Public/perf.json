  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Node & per-core temperature (°C)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/-cpu[0-9]+/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "rgba(140,140,140,0.4)"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sr.\"time\", sr.sensor_id AS metric, sr.temperature\nFROM sensor_readings sr\nWHERE $__timeFilter(sr.\"time\") AND sr.source = 'host' AND sr.temperature IS NOT NULL\nORDER BY 1"
        }
      ]
    },
