  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SSH failed logins (per minute)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never" }, "color": { "mode": "fixed", "fixedColor": "#E24B4A" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "postgres", "uid": "timescaledb" }, "format": "time_series", "rawQuery": true, "rawSql": "SELECT sr.\"time\", sr.sensor_id AS metric, sr.ssh_failed\nFROM sensor_readings sr\nWHERE $__timeFilter(sr.\"time\") AND sr.source = 'security' AND sr.ssh_failed IS NOT NULL\nORDER BY 1" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Accepted logins (your own access, per minute)",
