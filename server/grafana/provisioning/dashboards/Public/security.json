      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "postgres", "uid": "timescaledb" }, "format": "time_series", "rawQuery": true, "rawSql": "SELECT sr.\"time\", 'currently banned' AS metric, sr.f2b_banned\nFROM sensor_readings sr\nWHERE $__timeFilter(sr.\"time\") AND sr.source = 'security' AND sr.f2b_banned IS NOT NULL\nORDER BY 1" },
        { "refId": "B", "datasource": { "type": "postgres", "uid": "timescaledb" }, "format": "time_series", "rawQuery": true, "rawSql": "SELECT sr.\"time\", 'total banned (cumulative)' AS metric, sr.f2b_banned_total\nFROM sensor_readings sr\nWHERE $__timeFilter(sr.\"time\") AND sr.source = 'security' AND sr.f2b_banned_total IS NOT NULL\nORDER BY 1" }
      ]
