      "targets": [
        { "refId": "A", "datasource": { "type": "postgres", "uid": "timescaledb" }, "format": "time_series", "rawQuery": true, "rawSql": "SELECT sr.\"time\", sr.sensor_id AS metric, sr.ssh_ips\nFROM sensor_readings sr\nWHERE $__timeFilter(sr.\"time\") AND sr.source = 'security' AND sr.ssh_ips IS NOT NULL\nORDER BY 1" }
