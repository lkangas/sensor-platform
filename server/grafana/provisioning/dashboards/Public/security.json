      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never" }, "color": { "mode": "fixed", "fixedColor": "#1D9E75" } }, "overrides": [] },
