      "targets": [
        { "refId": "A", "datasource": { "type": "postgres", "uid": "timescaledb" }, "format": "time_series", "rawQuery": true, "rawSql": "SELECT sr.\"time\", sr.sensor_id AS metric, sr.ssh_accepted\nFROM sensor_readings sr\nWHERE $__timeFilter(sr.\"time\") AND sr.source = 'security' AND sr.ssh_accepted IS NOT NULL\nORDER BY 1" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Distinct attacking source IPs (per minute)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
