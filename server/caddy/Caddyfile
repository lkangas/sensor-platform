{
	# ACME account contact — also enables issuer fallback (e.g. ZeroSSL) if
	# Let's Encrypt is having an outage. Real value in server/.env (ACME_EMAIL).
	email {$ACME_EMAIL}
}

# The public FQDN comes from server/.env (PUBLIC_FQDN), passed into the container by
# docker-compose — the repo names no host. This block's only job now is to obtain the
# TLS cert (mosquitto reuses it for the 8883 listener); Grafana moved to the cloudflared
# tunnel, so nothing is proxied here — keep the block so the cert keeps issuing/renewing.
{$PUBLIC_FQDN} {
	respond 404
}
