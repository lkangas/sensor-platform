# Per-machine config — never committed (principle 3: only .env differs per machine)
**/.env
.env

# Secrets, certs, keys
*.pem
*.key
*.crt
secrets/
ansible/*.vault
ansible/**/vault*
server/mosquitto/passwd

# Rendered edge gateway config contains the site password (bootstrap generates it
# from config.yml.template); the template IS committed.
edge/ruuvi-go-gateway/config.yml

# Prebuilt edge binaries (fetched per-arch, not stored in git)
edge/bin/ruuvi-gateway-*
!edge/bin/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
