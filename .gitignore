# Per-machine config — never committed (principle 3: only .env differs per machine)
**/.env
.env

# Secrets, certs, keys
*.pem
*.key
*.crt
secrets/
ansible/*.vault
ansible/**/vault*
server/mosquitto/passwd

# Rendered edge gateway config contains the site password (bootstrap generates it
# from config.yml.template); the template IS committed.
edge/ruuvi-go-gateway/config.yml
# Rendered store-and-forward broker config also contains the site password.
edge/store-and-forward/mosquitto.conf

# Prebuilt edge binaries (fetched per-arch, not stored in git)
edge/bin/ruuvi-gateway-*
!edge/bin/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local-only notes (personal machine setup, hostnames, etc. — not for a public repo)
docs/local/

# Private tag metadata: friendly names + owner/category per MAC. The DATA is personal
# (whose tag, which room) and stays out of the public repo — only the .example template
# and the loader are committed. Same model as .env.
server/db/sensor-meta/tags.csv

# The "other" dashboard (owner=other) — provisioned on the VPS only, never committed,
# whichever folder (Public/Private) it currently sits in. (Temporarily in Public so it's
# visible without login; will move back to Private on request.)
server/grafana/provisioning/dashboards/*/other-sensors.json

# Scratch "Test" dashboard — temporary/experimental visualizations, provisioned on the
# VPS only, not committed.
server/grafana/provisioning/dashboards/*/test-dashboard.json

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
