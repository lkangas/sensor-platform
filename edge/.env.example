# Per-edge-node config. Copy to edge/.env on the node (git-ignored) and fill in.
# The bootstrap script templates ruuvi-go-gateway/config.yml from these values.

# Site name — becomes the topic prefix <site>/ruuvi/<mac> and the `site` column.
# Use the same name as the MQTT user's suffix (site-home -> SITE=home).
SITE=home

# VPS broker. MUST be the hostname, not an IP — the TLS cert is issued for
# petzval.dy.fi and ssl:// verifies it against the system CA bundle.
MQTT_HOST=petzval.dy.fi
MQTT_PORT=8883

# Per-site MQTT credentials (created on the VPS, see docs/EDGE-SETUP.md).
MQTT_USER=site-home
MQTT_PASS=

# Gateway MAC reported in the payload's gw_mac field. Cosmetic (this is not a
# physical Ruuvi Gateway); leave as-is or set to something identifying the node.
GW_MAC=00:00:00:00:00:00
